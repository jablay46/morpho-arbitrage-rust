# ============================================================
# Contoh konfigurasi pair WETH/VIRTUAL di Base.
# Semua alamat pool di DEX_VENUES sudah diverifikasi on-chain
# (2026-08) terhadap factory masing-masing DEX.
#
# Cara pakai:
#   cp .env.virtual .env
#   lalu isi RPC_URL, PRIVATE_KEY, dan ARB_CONTRACT (hasil deploy
#   kontrak FlashArbitrage terbaru yang mendukung kind=slipstream).
# ============================================================

# --- WAJIB DIEDIT ---
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=0x...
ARB_CONTRACT=0x...

# WSS opsional (mode event-driven); kosong = polling
# WSS_URL=wss://base-mainnet.core.chainstack.com/YOUR_KEY

# --- Alamat kontrak Base (jangan diubah) ---
MORPHO_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
LOAN_TOKEN=0x4200000000000000000000000000000000000006
QUOTE_TOKEN=0x0b3e328455c4059EEb9e3f84b5543F74E24e7E1b

# --- DEX_VENUES: 8 venue WETH/VIRTUAL, satu baris penuh ---
# 1) UniV2          0xE31c..a667  fee 30 bps   (~281 WETH)
# 2) Aero volatile  0x2159..27c7  fee 100 bps  (~950 WETH; fee terverifikasi via getFee)
# 3) UniV3 fee 500  0x9c08..b903
# 4) UniV3 fee 3000 0x1d4d..72f1
# 5) UniV3 fee10000 0x8e0a..1826
# 6) Slipstream ts=1   0x14ce..4627 (0.01%)
# 7) Slipstream ts=100 0x3f02..014a (1%)
# 8) Slipstream ts=200 0xc200..3065 (2%)
# Catatan: ts=50 dan ts=2000 tidak ada untuk pair ini; pool stable Aero
# hampir kosong sehingga tidak dimasukkan. Venue slipstream butuh kontrak
# FlashArbitrage versi baru (KIND_SLIPSTREAM) untuk eksekusi.
DEX_VENUES=0xE31c372a7Af875b3B5E0F3713B17ef51556da667:0x4752ba5DBc23f44D87826276BF6Fd6b1c372aD24:v2:30:0x8909Dc15e40173Ff4699343b6eB8132c65e18eC6,0x21594b992F68495Dd28d605834b58889d0a727c7:0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874e43:aero:100:0x420DD381b31aEf6683db6B902084cB0FFECe40Da:false,0x9c087eb773291e50cf6c6a90ef0f4500e349b903:0x2626664c2603336E57B271c5C0b26F421741e481:v3:30:0x33128a8fC17869897dcE68Ed026d694621f6FDfD::500,0x1d4dab3f27c7f656b6323c1d6ef713b48a8f72f1:0x2626664c2603336E57B271c5C0b26F421741e481:v3:30:0x33128a8fC17869897dcE68Ed026d694621f6FDfD::3000,0x8e0a7d4018fb2674346d5742055174f899fe1826:0x2626664c2603336E57B271c5C0b26F421741e481:v3:30:0x33128a8fC17869897dcE68Ed026d694621f6FDfD::10000,0x14cea6cd0157e0fba35a21c2eaed2a2aea774627:0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5:slipstream:30:0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A:false:1,0x3f0296bf652e19bca772ec3df08b32732f93014a:0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5:slipstream:30:0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A:false:100,0xc200f21efe67c7f41b81a854c26f9cda80593065:0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5:slipstream:30:0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A:false:200


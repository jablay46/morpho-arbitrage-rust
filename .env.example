# RPC endpoint (Base chain). Public RPC works for testing; go paid for prod.
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Base chain deployed endpoints (verify latest at official docs/basescan):
# - Morpho Blue:        0xBBBBBbbBBb1c36dE7883ce78c95903E57b7b3e6A
# - Uniswap V2 Router:  0x4752ba5DBc23f44D87826276BF6Fd6b1c372aD24
# - Aerodrome Router:   0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874e43
# WETH (Base):          0x4200000000000000000000000000000000000006

# Bot wallet (keep this secret; use a dedicated key)
PRIVATE_KEY=0x...

# Morpho Blue (mainnet)
MORPHO_ADDRESS=0xBBBBBbbBBb1c36dE7883ce78c95903E5eAA53De4

# Deployed FlashArbitrage contract address
ARB_CONTRACT=0x...

# Tokens to cycle: borrow LOAN_TOKEN, swap through QUOTE_TOKEN
LOAN_TOKEN=0x...
QUOTE_TOKEN=0x...

# DEX venues being arbitraged against each other, comma-separated entries:
#   <pair>:<router>[:<kind>[:<fee_bps>[:<factory>[:<stable>]]]]
#   kind     = v2 (default; UniswapV2/SushiswapV2/PancakeswapV2) | aero (Aerodrome)
#   fee_bps  = pool fee in basis points (default 30 = 0.3%)
#   factory  = Aerodrome pool factory (default zero = router default factory)
#   stable   = true for Aerodrome stable pools (default false)
DEX_VENUES=0xPairUniswapV2:0x4752ba5DBc23f44D87826276BF6Fd6b1c372aD24:v2:30,0xPairAerodrome:0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874e43:aero:30,0xPairSushiswapV2:0xRouterSushi:v2:30

# Comma-separated loan sizes to probe (base units)
LOAN_AMOUNTS=1000000000000000000,5000000000000000000

# Minimum profit threshold in LOAN_TOKEN base units
MIN_PROFIT=0

# Poll interval between scans (ms) for `scan` mode
POLL_INTERVAL_MS=5000

# Set to false to allow broadcasting transactions
DRY_RUN=true

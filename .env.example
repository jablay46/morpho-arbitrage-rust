# RPC endpoint (e.g. an Ethereum mainnet fork for testing)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Bot wallet (keep this secret; use a dedicated key)
PRIVATE_KEY=0x...

# Morpho Blue (mainnet)
MORPHO_ADDRESS=0xBBBBBbbBBb1c36dE7883ce78c95903E5eAA53De4

# Deployed FlashArbitrage contract address
ARB_CONTRACT=0x...

# Tokens to cycle: borrow LOAN_TOKEN, swap through QUOTE_TOKEN
LOAN_TOKEN=0x...
QUOTE_TOKEN=0x...

# The two pools being arbitraged against each other
PAIR_A=0x...
PAIR_B=0x...

# Comma-separated loan sizes to probe (base units)
LOAN_AMOUNTS=1000000000000000000,5000000000000000000

# Minimum profit threshold in LOAN_TOKEN base units
MIN_PROFIT=0

# Poll interval between scans (ms) for `scan` mode
POLL_INTERVAL_MS=5000

# Set to false to allow broadcasting transactions
DRY_RUN=true

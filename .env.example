# Gunakan file env lain selain .env: ENV_FILE=.env.virtual cargo run --release
# ENV_FILE=.env.virtual

# RPC endpoint (Base chain). Public RPC works for testing; go paid for prod.
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# WebSocket URL for event-driven scanning (Chainstack, Alchemy, etc.).
# If unset, the bot falls back to polling mode.
# WSS_URL=wss://base-mainnet.core.chainstack.com/YOUR_KEY

# Base chain deployed endpoints (verified on-chain 2026-08; re-check before deploy):
# - Morpho Blue:        0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
# - Uniswap V2 Router:  0x4752ba5DBc23f44D87826276BF6Fd6b1c372aD24
# - Aerodrome Router:   0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874e43
# - WETH (Base):        0x4200000000000000000000000000000000000006

# Bot wallet (keep this secret; use a dedicated key)
PRIVATE_KEY=0x...

# Morpho Blue singleton (same address on Base and Ethereum mainnet)
MORPHO_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb

# Deployed FlashArbitrage contract address
ARB_CONTRACT=0x...

# Tokens to cycle: borrow LOAN_TOKEN from Morpho, swap loan->quote on one
# DEX and quote->loan on another, repay, keep the difference.
# LOAN_TOKEN  = token being borrowed + profit unit (e.g. WETH)
# QUOTE_TOKEN = intermediate token of the cycle (e.g. USDC)
LOAN_TOKEN=0x4200000000000000000000000000000000000006
QUOTE_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Wrapped native token (used to price gas into loan-token units).
# Defaults to WETH on Base: 0x4200000000000000000000000000000000000006
# WRAPPED_NATIVE=0x4200000000000000000000000000000000000006

# DEX venues being arbitraged against each other, comma-separated entries:
#   <POOL>:<ROUTER>[:<kind>[:<fee_bps>[:<factory>[:<stable>[:<fee_tier>[:<pool_id>]]]]]
#   POOL     = pool/pair address, or "auto" to resolve it from the factory
#              at startup (factory field then required; zero is allowed for
#              aero = router default factory)
#   ROUTER   = the DEX swap router address
#   kind     = v2 (default; UniswapV2/SushiswapV2/PancakeswapV2) | aero (Aerodrome vAMM) | v3 (UniswapV3) | slipstream (Aerodrome CL) | v4 (UniswapV4, unimplemented)
#   fee_bps  = pool fee in basis points (default 30 = 0.3%).
#              V2/Aero only — IGNORED for v3 and slipstream venues, whose
#              pricing is driven by fee_tier below. Leave the default (or
#              any placeholder) for those kinds.
#   factory  = pool factory (needed for "auto"; zero = Aero default factory)
#   stable   = true for Aerodrome stable pools (default false)
#   fee_tier = Uniswap V3 fee tier in hundredths of a bip (default 3000 = 0.3%).
#              For `slipstream` this field carries the pool's tickSpacing
#              (one of 1 / 50 / 100 / 200 / 2000), not a fee.
#   pool_id  = Uniswap V4 pool ID as hex (default zero)
#
# Router/factory addresses on Base (verified on-chain):
#   Uniswap V2:  router 0x4752ba5DBc23f44D87826276BF6Fd6b1c372aD24
#                factory 0x8909Dc15e40173Ff4699343b6eB8132c65e18eC6
#   Aerodrome:   router 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874e43
#                factory 0x420DD381b31aEf6683db6B902084cB0FFECe40Da (default)
#   Uniswap V3:  router 0x2626664c2603336E57B271c5C0b26F421741e481
#                factory 0x33128a8fC17869897dcE68Ed026d694621f6FDfD
#                (pricing via QuoterV2, see QUOTER_V2 below)
#   Slipstream:  router 0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5
#                factory 0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A
#                quoter  0x254cF9E1E6e233aa1AC962CB9B05b2cfeAaE15b0
#
# Example A (explicit pools, WETH/USDC across Uniswap V2 + Aerodrome):
# DEX_VENUES=0x88A43bbDF9D098eEC7bCEda4e2494615dfD9bB9C:0x4752ba5DBc23f44D87826276BF6Fd6b1c372aD24:v2:30,0xcDAC0d6c6C59727a65F871236188350531885C43:0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874e43:aero:30
#
# Example B (auto pools: just name the DEXes, pools resolved at startup):
DEX_VENUES=auto:0x4752ba5DBc23f44D87826276BF6Fd6b1c372aD24:v2:30:0x8909Dc15e40173Ff4699343b6eB8132c65e18eC6,auto:0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874e43:aero:30:0x420DD381b31aEf6683db6B902084cB0FFECe40Da

# Example C (Slipstream CL leg: kind=slipstream, fee_tier carries tickSpacing):
#   auto:0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5:slipstream:30:0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A:false:100

# Comma-separated loan sizes to probe (base units). Each size multiplies
# the per-scan QuoterV2 calls (batch 2 grows quadratically), so keep this
# to ONE size unless the RPC plan has generous headroom.
LOAN_AMOUNTS=1000000000000000000

# Minimum NET profit (after gas) in LOAN_TOKEN base units required to
# execute. Must be > 0 when DRY_RUN=false — a zero floor allows
# economically meaningless trades that only burn gas.
#
# The scanner ranks every profitable route by gross, simulates gas for the
# top candidates, and executes the one with the highest NET (gross − gas).
# Before broadcasting, any CL leg priced from local tick state is re-quoted
# once against the venue's Quoter (constant tolerance 25 bps); a mismatch
# drops the cached state and skips the trade rather than trust a wrong value.
MIN_PROFIT=1000000000000000

# Uniswap QuoterV2 address used to price V3 legs (real tick/liquidity
# traversal via eth_call). The default below is BASE-SPECIFIC — other
# chains deploy QuoterV2 elsewhere (e.g. Ethereum mainnet:
# 0x61fFE014bA17989E743c5F6cB21bF9697530B21e), so set this explicitly
# when targeting a non-Base chain.
# QUOTER_V2=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a

# Aerodrome Slipstream Quoter used to price CL (slipstream) legs. Also
# BASE-SPECIFIC — set explicitly for other chains.
# QUOTER_SLIPSTREAM=0x254cF9E1E6e233aa1AC962CB9B05b2cfeAaE15b0

# NOTE: LOAN_TOKEN must equal WRAPPED_NATIVE. Gas is paid in ETH, and only
# a native-denominated loan lets the bot subtract the wei gas estimate from
# profit exactly; any other loan token would silently degrade net-profit
# filtering to gross-profit, so config validation rejects it.

# Per-leg slippage tolerance in basis points (50 = 0.5%); the simulated leg
# output scaled down by this becomes the on-chain minOut (sandwich protection)
SLIPPAGE_BPS=50

# Poll interval between scans (ms) for `scan` mode
POLL_INTERVAL_MS=5000
# Max age of the locally cached CL pool state before a full re-bootstrap
# (seconds). Polling mode has no event stream, so this is the only path that
# refreshes local tick/bitmap/liquidity snapshots between scans.
STATE_REFRESH_SECS=60

# Safety-net sweep interval (blocks) for event-driven mode: a full scan is
# forced at least every N blocks even without pool events. Default 10.
# SWEEP_INTERVAL_BLOCKS=10

# Subscribe to newHeads over WSS to time sweeps by block. Providers bill
# every header notification by bandwidth (Alchemy: 0.04 CU/byte, ~28 CU per
# 2s block => ~1.2M CU/day), so the default is false and sweeps run on a
# wall-clock timer of the same cadence. Enable only where bandwidth is free
# (e.g. your own node).
# USE_NEW_HEADS=false

# Minimum gap between event-driven scans (ms). Caps JSON-RPC bursts on
# RPS-limited plans (e.g. Chainstack 25 RPS): triggers inside the cooldown
# are dropped because the next scan reads `latest`, which already includes
# their state changes. Default 2000 (~0.5 scan/s); set to 0 to disable.
# MIN_SCAN_INTERVAL_MS=2000

# Set to false to allow broadcasting transactions
DRY_RUN=true

# --- Base Flashblocks (sub-block 200ms preconfirmations) ---
# Requires a Flashblock-aware RPC/WSS endpoint (Chainstack, Dwellir, QuickNode).
# The bot probes the endpoint at startup and auto-falls back to sealed-block
# behavior if Flashblocks are unavailable, so these are safe to leave on.
# Set FLASHBLOCKS=false to disable all four layers at once.
FLASHBLOCKS=true
# Read reserves/quotes/gasPrice from the `pending` (~200ms) block tag instead
# of `latest` (2s). Opportunities are detected ~10x fresher.
USE_PENDING_STATE=true
# Submit trades via the synchronous path (~200ms receipt) instead of
# fire-and-forget, so the in-flight flag clears ~10x sooner.
USE_FLASHBLOCK_SYNC=true
# Subscribe to pendingLogs so scans fire ~200ms after a pool event instead of
# at the next sealed block. Falls back to sealed logs if the endpoint refuses.
USE_PENDING_LOGS=true
# Run the estimate_gas gate against pending state to reject trades a competing
# Flashblock already made unprofitable. Off by default (extra eth_call/oppty).
USE_PENDING_SIM=false

# Estimate gas for execute() locally with an embedded EVM (revm) instead of
# eth_estimateGas. Reverts are treated as per-opportunity rejections exactly
# like the node path; any transport/DB error falls back to eth_estimateGas,
# so enabling this is strictly additive. The first simulation per block does
# ~tens of lazy eth_getCode/eth_getStorageAt fetches -- keep it off on
# RPS-limited RPC plans.
USE_LOCAL_SIM=false
